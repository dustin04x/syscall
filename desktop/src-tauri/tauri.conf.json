{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYSCALL Workbench",
  "version": "0.1.0",
  "identifier": "dev.syscall.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SYSCALL Workbench",
        "width": 1480,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0a0c0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Linux process intelligence and runtime forensics",
    "longDescription": "Read-only forensic investigation workbench for recorded SYSCALL evidence."
  }
}
